{
    "compilerOptions": {
      "lib": ["dom", "dom.iterable", "esnext"],
      "target": "esnext",
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "module": "preserve",
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "noEmit": true,
      "jsx": "react-jsx"
    },
    "include": ["src"]
}
