# Production settings, read by `docker compose -f docker-compose.yml -f docker-compose.prod.yml`.
# Copy to .env on the droplet (next to docker-compose.yml) and fill in real values.
# Values must not contain "$" (Compose would treat it as a variable).

# Django signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Password for the conjugaciones-user database role. Postgres only applies it
# when ./pgdata is first initialised; to change it on an existing database,
# run ALTER USER inside Postgres as well (see README).
POSTGRES_PASSWORD=
